# ----------------------------------------------------------------------
# The Perfect Look — environment variables (canonical reference).
#
# Copy this file to the location each tool expects and fill in real
# values from the forked Supabase project. NEVER commit real values:
# keep them in GitHub Actions secrets / a machine-local .env file.
# ----------------------------------------------------------------------

# Frontend (web/.env)
# Values come from Supabase -> Project Settings -> API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Migration tool (tools/, T25) — service-role key is SERVER-SIDE ONLY.
# Never ship this to the browser or commit it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Seed admin account (supabase/seed.sql, T3) — the bootstrap admin is
# created with these values when you run the seed. Use strong values.
SUPABASE_ADMIN_EMAIL=admin@theperfectlook.ae
SUPABASE_ADMIN_PASSWORD=replace-with-a-strong-password